.env
*.env
!*.env.example
credentials.*
*_secret.*
*.key
.git_token
.git_credentials

# ============================================
# 临时文件
# ============================================
*.tmp
~*
*~
.cache/
__pycache__/
*.pyc
*.pyo
.ST*/
.st*/
*.lock

# ============================================
# 系统和 IDE
# ============================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ============================================
