# ============================================
# 数据管道 API 配置文件
# ⚠️ 不要分享给任何人！包含你的私人API Key
#
# 使用方法：
#   1. 复制此文件为 .env（去掉 .example 后缀）
#   2. 填入你注册的 API Key
#   3. 运行 python main.py --matches "Viking vs Sarpsborg"
# ============================================

# The Odds API (赔率数据) — 最重要！
# 注册地址: https://the-odds-api.com/
# 免费额度: 500次/月
ODDS_API_KEY=your-the-odds-api-key-here

# API-Football via RapidAPI (伤停/阵容/H2H/积分)
# 注册地址: https://rapidapi.com/api-sports/api/api-football/pricing
# 免费额度: 100次/天
RAPID_API_KEY=your-rapidapi-key-here

# Football-data.org (积分/赛程，大联赛专用)
# 注册地址: https://www.football-data.org/client/register
# 免费额度: 完全免费无限额（需审批约24h）
FOOTBALL_DATA_TOKEN=your-football-data-token-here

# Open-Meteo (天气) — 无需Key，留空即可
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
